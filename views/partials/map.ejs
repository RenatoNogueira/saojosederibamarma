<section class="sec light map-sec" id="mapa">
  <div class="wrap">
    <header class="sec-head reveal">
      <p class="eyebrow"><span>04</span> Como chegar</p>
      <h2>Do mapa <em>ao destino</em></h2>
      <p class="lead"><%= getting.intro %></p>
    </header>

    <div class="route-facts reveal">
      <% getting.facts.forEach(function(f){ %>
      <div class="rf"><small><%= f.k %></small><b><%= f.v %></b><span><%= f.n %></span></div>
      <% }) %>
    </div>

    <div class="map-grid reveal">
      <nav class="dest-list" id="destList" aria-label="Destinos">
        <% routes.forEach(function(r, i){ %>
        <button class="dest <%= i === 0 ? 'on' : '' %>" data-dest="<%= r.id %>" aria-pressed="<%= i === 0 %>">
          <span class="dest-ic"><%- icon(r.icon) %></span>
          <span class="dest-tx"><b><%= r.name %></b><small><%= r.dist %></small></span>
          <%- icon('arrow') %>
        </button>
        <% }) %>
      </nav>

      <div class="map-card">
        <div class="map-frame" id="mapFrame">
          <div class="map-poster" id="mapPoster">
            <span class="map-pin"><%- icon('pin') %></span>
            <p id="posterName">Visão geral da cidade</p>
            <button class="btn p" id="mapLoad">Carregar mapa interativo</button>
            <small>O mapa é do Google Maps e só é carregado depois do seu clique.</small>
          </div>
        </div>

        <div class="map-info" aria-live="polite">
          <div>
            <h3 id="destName"></h3>
            <p id="destLine"></p>
            <p class="dest-addr" id="destAddr" hidden></p>
          </div>
          <div class="map-actions">
            <a class="btn p" id="goRoute" target="_blank" rel="noopener"><%- icon('arrow') %> Traçar rota<span class="sr"> (abre em nova aba)</span></a>
            <a class="btn" id="goMap" target="_blank" rel="noopener"><%- icon('pin') %> Abrir no Maps<span class="sr"> (abre em nova aba)</span></a>
            <a class="btn" id="goWaze" target="_blank" rel="noopener">Waze<span class="sr"> (abre em nova aba)</span></a>
            <button class="btn" id="copyAddr"><%- icon('share') %> Copiar endereço</button>
          </div>
        </div>
      </div>
    </div>

    <ul class="tips reveal">
      <% getting.tips.forEach(function(t){ %><li><%- icon('bulb') %><span><%= t %></span></li><% }) %>
    </ul>
  </div>
</section>
