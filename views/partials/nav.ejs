    <a class="logo" href="#top" aria-label="São José de Ribamar — início"><b></b><span>Ribamar</span></a>
    <nav aria-label="Seções" id="navLinks">
      <% nav.forEach(function(n){ %><a href="#<%= n[0] %>" data-spy="<%= n[0] %>"><%= n[1] %></a><% }) %>
