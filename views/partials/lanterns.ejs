<section class="sec lanterns" id="luzes">
  <div class="wrap narrow">
    <header class="sec-head reveal">
      <p class="eyebrow"><span>12</span> Procissão luminosa</p>
      <h2>Acenda <em>uma luz</em></h2>
      <p class="lead" id="lLead">Escolha o que sua lanterna carrega, escreva uma frase e solte-a no céu da procissão. Ela fica guardada neste navegador — e só você a vê.</p>
    </header>

    <form class="lantern-form reveal" id="lanternForm" data-k="gratidao">
      <div class="lf-main">
        <div class="lf-fields">
          <p class="lf-title">O que sua luz carrega?</p>
          <div class="kinds" role="radiogroup" aria-label="Tipo de intenção">
            <button type="button" class="kind" role="radio" aria-checked="true" data-k="gratidao">Gratidão<small>agradecer uma graça</small></button>
            <button type="button" class="kind" role="radio" aria-checked="false" data-k="pedido">Pedido<small>pedir proteção</small></button>
            <button type="button" class="kind" role="radio" aria-checked="false" data-k="lembranca">Lembrança<small>honrar alguém</small></button>
          </div>

          <div class="lf-box">
            <label for="lMsg" class="sr">Sua mensagem</label>
            <textarea id="lMsg" maxlength="140" rows="3" placeholder="Obrigado, São José, por…"></textarea>
            <label for="lFrom" class="sr">Assinatura (opcional)</label>
            <input id="lFrom" class="lf-from" maxlength="30" placeholder="Assinatura (opcional)">
          </div>

          <div class="lf-share" id="lShareRow" hidden>
            <label><input type="checkbox" id="lShare" checked><span>Deixar que outras pessoas leiam esta lanterna</span></label>
            <p>Mensagens públicas passam por um filtro, ficam visíveis por até 7 dias e podem ser denunciadas. Não escreva dados pessoais.</p>
          </div>

          <div class="lf-row">
            <span class="lf-count">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle class="bg" cx="12" cy="12" r="10"/><circle class="fg" id="lRing" cx="12" cy="12" r="10"/></svg>
              <span id="lCount">0 / 140</span>
            </span>
            <button class="lf-submit" type="submit">Soltar lanterna ✦</button>
          </div>
        </div>

        <div class="lf-preview" aria-hidden="true">
          <div class="lantern-shell" id="lPreview">
            <span class="lamp-wrap" style="--glow:.7"><span class="halo"></span><span class="lamp"><i></i></span></span>
          </div>
          <p>Sua lanterna</p>
        </div>
      </div>
    </form>

    <div class="sky-wrap reveal">
      <div class="sky-meta">
        <span><b id="skyCount">0</b> <span id="skyLbl">lanternas no céu</span><em id="skyHint" hidden> · toque em uma para ler</em></span>
        <button type="button" id="skyClear">Limpar minhas lanternas</button>
      </div>
      <div class="sky-box" id="skyBox" aria-label="Céu com as lanternas acesas">
        <div class="sea-l" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="l-card" id="lCard" role="dialog" aria-live="polite" aria-label="Mensagem da lanterna">
          <button class="l-x" id="lCardX" aria-label="Fechar mensagem"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          <span class="l-kind" id="lKind"></span>
          <p class="l-msg" id="lMsgOut"></p>
          <div class="l-foot"><b id="lFromOut"></b><span id="lWhen"></span></div>
          <button type="button" class="l-report" id="lReport" hidden>Denunciar esta mensagem</button>
        </div>
      </div>
    </div>
  </div>
</section>
