<section class="sec light" id="quiz">
  <div class="wrap">
    <div class="quiz-grid">
    <header class="sec-head reveal">
      <p class="eyebrow"><span>12</span> Desafio</p>
      <h2>Quanto você <em>sabe de Ribamar?</em></h2>
      <p class="lead">Oito perguntas com o que você viu na página. Cada resposta vem com uma explicação.</p>
    </header>

    <div class="quiz-col">
    <div class="quiz reveal" id="quizBox">
      <div class="quiz-top"><span id="qNo">Pergunta 1 de <%= quiz.length %></span><div class="qbar"><i id="qBar"></i></div></div>
      <h3 id="qText"></h3>
      <div class="qopts" id="qOpts"></div>
      <div class="qexp" id="qExp" role="status" hidden></div>
      <div class="qctl"><button class="btn p" id="qNext" hidden>Próxima</button></div>
    </div>
    <div class="quiz-end" id="quizEnd" hidden>
      <div class="medal" id="qMedal"></div>
      <h3 id="qScore"></h3>
      <p id="qMsg"></p>
      <button class="btn p" id="qRestart">Jogar de novo</button>
    </div>
    </div>
    </div>
  </div>
</section>
