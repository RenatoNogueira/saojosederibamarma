<section class="hero" id="hero" data-time="night" aria-label="São José de Ribamar">
  <div class="curtain" aria-hidden="true"></div>

  <div class="layer sky sky-night"></div>
  <div class="layer sky sky-day"></div>
  <div class="layer dawn"></div>
  <canvas id="stars" class="layer" aria-hidden="true"></canvas>
  <div class="cloud c1" aria-hidden="true"></div><div class="cloud c2" aria-hidden="true"></div>

  <div class="puffs" aria-hidden="true">
    <i class="puff p1"></i><i class="puff p2"></i><i class="puff p3"></i><i class="puff p4"></i><i class="puff p5"></i>
  </div>

  <div class="sun-wrap" aria-hidden="true"><div class="sun"></div></div>
  <div class="moon-wrap" aria-hidden="true"><div class="moon"></div></div>

  <button class="sky-toggle" id="skyToggle" type="button" aria-label="Mudar o céu para o dia">
    <span class="sky-ic i-sun"><%- icon('sun') %></span><span class="sky-ic i-moon"><%- icon('moon') %></span>
  </button>


  <div class="hero-copy">
    <span class="kicker">Maranhão · Baía de São José</span>
    <h1 class="big" aria-label="Ribamar"></h1>
    <p class="tagline">São José de Ribamar — onde a fé encontra o mar</p>
  </div>

  <div class="church-wrap" id="church">
    <img src="img/igreja.webp" alt="Igreja-Santuário de São José de Ribamar">
  </div>
  <div class="statue-wrap" id="statue">
    <img src="img/santo.webp" alt="Monumento a São José de Ribamar">
  </div>

  <div class="sea" aria-hidden="true">
    <div class="wave w1"></div><div class="wave w2"></div><div class="wave w3"></div><div class="wave w4"></div>
  </div>
  <canvas id="lights" aria-hidden="true"></canvas>

  <ul class="hero-chips" aria-label="Destaques">
    <li><b>Padroeiro</b> do Maranhão</li>
    <li><b><%= fmt(numbers[1].value) %></b> habitantes · <%= numbers[1].short %></li>
    <li><b>Setembro</b> · Patrimônio Imaterial</li>
  </ul>

  <a class="scroll-cue" href="#numeros" aria-label="Rolar para o conteúdo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></a>
</section>
